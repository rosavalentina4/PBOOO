    color: #1F4E46;
}

QLabel {
    color: #1E2D2B;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QPlainTextEdit {
    background-color: #F9FBFA;
    border: 1px solid #C8D7D3;
    border-radius: 5px;
    padding: 6px 8px;
    color: #1E2D2B;
    font-size: 13px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QPlainTextEdit:focus {
    border: 1px solid #2A7B6F;
    background-color: #FFFFFF;
}

QLineEdit:read-only {
    background-color: #EEF3F1;
    color: #5C706C;
}

QPushButton[btnType="secondary"] {
    background-color: #2A6F8E;
    color: #FFFFFF;
    border: none;
    border-radius: 5px;
    padding: 7px 14px;
    font-weight: bold;
}

QPushButton[btnType="secondary"]:hover {
    background-color: #215973;
}

QPushButton[btnType="primary"] {
    background-color: #266D61;
    color: #FFFFFF;
    border: none;
    border-radius: 5px;
    padding: 7px 14px;
    font-weight: bold;
}

QPushButton[btnType="primary"]:hover {
    background-color: #1F5B51;
}

QPushButton[btnType="neutral"] {
    background-color: #EDF3F1;
    color: #2B423E;
    border: 1px solid #C8D7D3;
    border-radius: 5px;
    padding: 7px 14px;
}

QPushButton[btnType="neutral"]:hover {
    background-color: #DFEAE6;
}</string>
