  <property name="styleSheet">
   <string notr="true">QWidget#LoginWindow {
    background-color: #F2F6F5;
    font-family: &quot;Segoe UI&quot;, &quot;Helvetica Neue&quot;, Arial, sans-serif;
    color: #1E2D2B;
}

QFrame#frameBrand {
    background-color: #1F4E46;
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
}

QLabel#lblBrandTitle {
    color: #FFFFFF;
    font-size: 22px;
    font-weight: bold;
}

QLabel#lblBrandSubtitle {
    color: #CBE2DC;
    font-size: 13px;
}

QLabel#lblBrandNote {
    color: #9FC5BC;
    font-size: 12px;
}

QFrame#frameForm {
    background-color: #FFFFFF;
    border: 1px solid #D9E4E1;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
}

QLabel#lblLoginHeader {
    color: #1B3B36;
    font-size: 20px;
    font-weight: bold;
}

QLabel#lblLoginSub {
    color: #5C706C;
    font-size: 12px;
}

QLabel.fieldLabel {
    color: #2B423E;
    font-size: 12px;
    font-weight: bold;
}

QLineEdit, QComboBox {
    background-color: #F9FBFA;
    border: 1px solid #C8D7D3;
    border-radius: 6px;
    padding: 8px 10px;
    font-size: 13px;
    color: #1E2D2B;
}

QLineEdit:focus, QComboBox:focus {
    border: 1px solid #2A7B6F;
    background-color: #FFFFFF;
}

QComboBox::drop-down {
    border: none;
    width: 26px;
}

QCheckBox {
    color: #4A615D;
    font-size: 12px;
}

QLabel#lblError {
    color: #B91C1C;
    font-size: 12px;
}

QPushButton#btnLogin {
    background-color: #266D61;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 10px 16px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton#btnLogin:hover {
    background-color: #1F5B51;
}

QPushButton#btnLogin:pressed {
    background-color: #194A42;
}

QPushButton#btnReset {
    background-color: #EDF3F1;
    color: #2B423E;
    border: 1px solid #C8D7D3;
    border-radius: 6px;
    padding: 10px 14px;
    font-size: 13px;
}

QPushButton#btnReset:hover {
    background-color: #E1ECE9;
}</string>
