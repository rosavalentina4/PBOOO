  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget#centralwidget {
    background-color: #F2F6F5;
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    color: #1E2D2B;
    font-size: 13px;
}

/* Sidebar */
QFrame#frameSidebar {
    background-color: #1F4E46;
    border: none;
}

QLabel#lblAppTitle {
    color: #FFFFFF;
    font-size: 18px;
    font-weight: bold;
    letter-spacing: 1px;
}

QLabel#lblAppSubtitle {
    color: #B8DAD2;
    font-size: 12px;
}

QLabel#lblUserInfo {
    color: #CBE2DC;
    font-size: 12px;
    padding: 6px 8px;
    background-color: #193F39;
    border-radius: 6px;
}

QPushButton[navButton="true"] {
    background-color: transparent;
    color: #E2F0EC;
    border: none;
    border-radius: 6px;
    text-align: left;
    padding: 10px 14px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton[navButton="true"]:hover {
    background-color: #296359;
    color: #FFFFFF;
}

QPushButton[navButton="true"]:checked {
    background-color: #2E7D6F;
    color: #FFFFFF;
    font-weight: bold;
    border-left: 4px solid #A7E3D4;
}

QPushButton#btnLogout {
    background-color: #183D37;
    color: #F5D0D0;
    border: 1px solid #30665D;
    border-radius: 6px;
    padding: 9px 14px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton#btnLogout:hover {
    background-color: #991B1B;
    color: #FFFFFF;
    border-color: #991B1B;
}

/* Header Bar */
QFrame#frameHeader {
    background-color: #FFFFFF;
    border-bottom: 1px solid #D9E4E1;
}

QLabel#lblPageTitle {
    color: #1B3B36;
    font-size: 17px;
    font-weight: bold;
}

QLabel#lblHeaderInfo {
    color: #5C706C;
    font-size: 12px;
}

/* Cards &amp; GroupBoxes */
QFrame[statCard="true"] {
    background-color: #FFFFFF;
    border: 1px solid #D9E4E1;
    border-top: 3px solid #266D61;
    border-radius: 8px;
}

QLabel[statTitle="true"] {
    color: #5C706C;
    font-size: 12px;
    font-weight: bold;
}

QLabel[statValue="true"] {
    color: #1B3B36;
    font-size: 19px;
    font-weight: bold;
}

QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #D9E4E1;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 14px;
    font-weight: bold;
    color: #1B3B36;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    background-color: #FFFFFF;
    color: #1F4E46;
}

/* Tabs */
QTabWidget::pane {
    background-color: #FFFFFF;
    border: 1px solid #D9E4E1;
    border-radius: 6px;
    top: -1px;
}

QTabBar::tab {
    background-color: #E4ECE9;
    color: #2B423E;
    padding: 8px 18px;
    border: 1px solid #D9E4E1;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 4px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #1F4E46;
    font-weight: bold;
    border-bottom-color: #FFFFFF;
}

/* Inputs */
QLineEdit, QComboBox, QDateEdit, QSpinBox, QDoubleSpinBox, QPlainTextEdit {
    background-color: #F9FBFA;
    border: 1px solid #C8D7D3;
    border-radius: 5px;
    padding: 6px 8px;
    color: #1E2D2B;
    font-size: 13px;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QPlainTextEdit:focus {
    border: 1px solid #2A7B6F;
    background-color: #FFFFFF;
}

QLineEdit:read-only {
    background-color: #EEF3F1;
    color: #5C706C;
}

/* Tables */
QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F6FAF8;
    border: 1px solid #D9E4E1;
    border-radius: 6px;
    gridline-color: #E6EEEC;
    selection-background-color: #D2EBE5;
    selection-color: #14332E;
}

QHeaderView::section {
    background-color: #E7F0ED;
    color: #1B3B36;
    padding: 7px 8px;
    border: none;
    border-right: 1px solid #D3E0DC;
    border-bottom: 1px solid #C8D7D3;
    font-weight: bold;
    font-size: 12px;
}

/* Action Buttons */
QPushButton[btnType="primary"] {
    background-color: #266D61;
    color: #FFFFFF;
    border: none;
    border-radius: 5px;
    padding: 7px 14px;
    font-weight: bold;
}

QPushButton[btnType="primary"]:hover {
    background-color: #1F5B51;
}

QPushButton[btnType="secondary"] {
    background-color: #2A6F8E;
    color: #FFFFFF;
    border: none;
    border-radius: 5px;
    padding: 7px 14px;
    font-weight: bold;
}

QPushButton[btnType="secondary"]:hover {
    background-color: #215973;
}

QPushButton[btnType="danger"] {
    background-color: #C24141;
    color: #FFFFFF;
    border: none;
    border-radius: 5px;
    padding: 7px 14px;
    font-weight: bold;
}

QPushButton[btnType="danger"]:hover {
    background-color: #9E3030;
}

QPushButton[btnType="neutral"] {
    background-color: #EDF3F1;
    color: #2B423E;
    border: 1px solid #C8D7D3;
    border-radius: 5px;
    padding: 7px 14px;
}

QPushButton[btnType="neutral"]:hover {
    background-color: #DFEAE6;
}</string>
