    font-size: 13px;
}

QFrame#frameDialogHeader {
    background-color: #FFFFFF;
    border-bottom: 1px solid #D9E4E1;
}

QLabel#lblDialogTitle {
    color: #1B3B36;
    font-size: 17px;
    font-weight: bold;
}

QLabel#lblDialogSubtitle {
    color: #5C706C;
    font-size: 12px;
}

QFrame[statCard="true"] {
    background-color: #FFFFFF;
    border: 1px solid #D9E4E1;
    border-top: 3px solid #266D61;
    border-radius: 8px;
}

QFrame[statCard="true"][cardAccent="blue"] {
    border-top: 3px solid #2A6F8E;
}

QLabel[statTitle="true"] {
    color: #5C706C;
    font-size: 12px;
    font-weight: bold;
}

QLabel[statValue="true"] {
    color: #1B3B36;
    font-size: 17px;
    font-weight: bold;
}

QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #D9E4E1;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 14px;
    font-weight: bold;
    color: #1B3B36;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    background-color: #FFFFFF;
    color: #1F4E46;
}

QLabel {
    color: #1E2D2B;
}

QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #F9FBFA;
    border: 1px solid #C8D7D3;
    border-radius: 5px;
    padding: 6px 8px;
    color: #1E2D2B;
    font-size: 13px;
}

QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #2A7B6F;
    background-color: #FFFFFF;
}

QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F6FAF8;
    border: 1px solid #D9E4E1;
    border-radius: 6px;
    gridline-color: #E6EEEC;
    selection-background-color: #D2EBE5;
    selection-color: #14332E;
}

QHeaderView::section {
    background-color: #E7F0ED;
    color: #1B3B36;
    padding: 7px 8px;
    border: none;
    border-right: 1px solid #D3E0DC;
    border-bottom: 1px solid #C8D7D3;
    font-weight: bold;
    font-size: 12px;
}

QPushButton[btnType="primary"] {
    background-color: #266D61;
    color: #FFFFFF;
    border: none;
    border-radius: 5px;
    padding: 7px 14px;
    font-weight: bold;
}

QPushButton[btnType="primary"]:hover {
    background-color: #1F5B51;
}

QPushButton[btnType="secondary"] {
    background-color: #2A6F8E;
    color: #FFFFFF;
    border: none;
    border-radius: 5px;
    padding: 7px 14px;
    font-weight: bold;
}

QPushButton[btnType="secondary"]:hover {
    background-color: #215973;
}

QPushButton[btnType="neutral"] {
    background-color: #EDF3F1;
    color: #2B423E;
    border: 1px solid #C8D7D3;
    border-radius: 5px;
    padding: 7px 14px;
}

QPushButton[btnType="neutral"]:hover {
    background-color: #DFEAE6;
}</string>
